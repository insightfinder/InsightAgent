# InsightFinder Configuration
INSIGHTFINDER_URL="https://stg.insightfinder.com"
INSIGHTFINDER_USER_NAME="your-username"
INSIGHTFINDER_LICENSE_KEY="your-license-key"
INSIGHTFINDER_PROJECT_NAME="accessparks-device-metadata"
INSIGHTFINDER_SYSTEM_NAME="your-system-name"
INSIGHTFINDER_SAMPLING_INTERVAL="1"  # in hours — this is a cron job, not a daemon; cadence is set by cron, not this value
INSIGHTFINDER_SET_COMPONENT="true"   # include componentName (controller name) on each log record

# AccessParks Jira Asset (Asset Registry service — mirrors Jira Assets)
JIRAASSET_BASE="http://54.234.90.98"
JIRAASSET_API_KEY="your-accessparks-api-key"

# Zabbix (reachable via SSH tunnel — see scripts/zabbix-tunnel.sh)
ZABBIX_URL="http://localhost:9999/zabbix"
ZABBIX_USER="your-zabbix-user"
ZABBIX_PASSWORD="your-zabbix-password"

# Zabbix SSH tunnel (used only by scripts/zabbix-tunnel.sh, not by the agent itself).
# Prefer SSH key auth if the server supports it: drop these and change the script's
# `sshpass -e ssh ...` to plain `ssh -i /path/to/key ...`.
ZABBIX_TUNNEL_SSH_HOST="your-zabbix-ssh-host"
ZABBIX_TUNNEL_SSH_PORT="22"
ZABBIX_TUNNEL_SSH_USER="your-ssh-user"
ZABBIX_TUNNEL_SSH_PASSWORD="your-ssh-password"
ZABBIX_TUNNEL_REMOTE="192.168.x.x:80"
ZABBIX_TUNNEL_LOCAL_PORT="9999"

# Baicells CloudCore. :7085 is the CloudCore API port (not the bare domain).
# 20 requests/min account-wide — IP requires one extra per-device call, cached to
# .cache/baicells_ips.json and capped by BAICELLS_ENRICH_BUDGET_SECONDS per run so a
# large fleet fills in over several runs instead of blocking one run for N/20 minutes.
BAICELLS_BASE_URL="https://cloudcore.baicells.com:7085"
BAICELLS_USERNAME="your-baicells-username"
BAICELLS_PASSWORD="your-baicells-password"
BAICELLS_ENRICH_BUDGET_SECONDS="900"

# Cambium (cnMaestro Cloud). No password-based REST API exists for this product — auth
# is done by driving the real login page with Playwright and lifting session cookies
# (see src/controllers/cambium.py). Requires `playwright install chromium` once.
# CAMBIUM_BASE_URL is the tenant API base, NOT the login page — it embeds a site name
# (LAKEMEAD1 below); comma-separate multiple sites to cover more than one.
CAMBIUM_BASE_URL="https://us-e1-s13-uu1wy2rsoz.cloud.cambiumnetworks.com/LAKEMEAD1/cn-srv"
CAMBIUM_EMAIL="your-cambium-email"
CAMBIUM_PASSWORD="your-cambium-password"

# Mimosa Cloud. network_id has no discovery API — 6078 is the AccessParks value used by
# every existing Mimosa reference agent.
MIMOSA_URL="https://cloud.mimosa.co"
MIMOSA_USERNAME="your-mimosa-username"
MIMOSA_PASSWORD="your-mimosa-password"
MIMOSA_NETWORK_ID="6078"

# NetExperience CMAP portal. base_url is the tenant API host (NOT www.netexperience.com —
# that's the marketing site). service_provider_id=58 is the AccessParks value from the
# existing netexperience-agent config. IP requires a third per-equipment status call;
# NETEXPERIENCE_FETCH_IP defaults on since NetExperience's 180 req/10s quota clears a
# fleet in well under a minute.
NETEXPERIENCE_BASE_URL="https://cmap-portal-svc.prod1.netexperience.com"
NETEXPERIENCE_USER_ID="your-netexperience-user-id"
NETEXPERIENCE_PASSWORD="your-netexperience-password"
NETEXPERIENCE_SERVICE_PROVIDER_ID="58"
NETEXPERIENCE_FETCH_IP="true"

# Positron (GAM headend units + CPE endpoints, HTTPS Basic Auth). Reached through the
# same SSH tunnel as Zabbix — 192.168.102.16 is on the same internal subnet as the
# Zabbix host (192.168.102.31) — see POSITRON_TUNNEL_* and scripts/zabbix-tunnel.sh.
POSITRON_URL="https://localhost:8443"
POSITRON_USERNAME="your-positron-username"
POSITRON_PASSWORD="your-positron-password"

# Ruckus SmartZone WSG public API (controller.accessparks.com). Reachable
# directly, no SSH tunnel/bastion needed — confirmed live via
# GET {RUCKUS_URL}/wsg/api/public/apiInfo, which reports
# apiSupportVersions: v9_0, v9_1, v10_0, v11_0, v11_1. RUCKUS_API_VERSION is
# pinned to the highest supported, v11_1.
RUCKUS_URL="https://209.170.222.172:8443"
RUCKUS_USERNAME="your-ruckus-username"
RUCKUS_PASSWORD="your-ruckus-password"
RUCKUS_API_VERSION="v11_1"

# Tarana Cloud Suite (TCS). region_ids pinned to the known-good set from the deployed
# accessParks-tarana metrics agent's config.yaml (region_ids: [33, 1203, 1202]) — this
# repo's own runtime discovery via GET /api/nqs/v1/operators/{operatorId}/regions
# (operatorId read from the login idToken) only ever surfaced region 33, so leaving
# TARANA_REGION_IDS blank would silently miss devices in 1203/1202. Leave blank only
# if you've independently confirmed discovery returns the full set for this account.
TARANA_BASE_URL="https://portal.tcs.taranawireless.com"
TARANA_USERNAME="your-tarana-username"
TARANA_PASSWORD="your-tarana-password"
TARANA_REGION_IDS="33,1203,1202"

# Telrad — CPEs only, via the BreezeVIEW CLI over SSH (requires `sshpass` on this host).
# This is a DIFFERENT SERVICE from the Telrad REST NBI, on a DIFFERENT PORT on the same
# host (9383 here vs. the REST NBI's 9382) — pointing at the wrong one fails every run.
# The REST NBI (eNBs) is deliberately not implemented; see README.md.
# Port 9383 firewalls by source IP to the EC2 box (34.236.220.137) —
# only reachable directly from there. For local dev, set this to "localhost" and run
# ./scripts/telrad-breezeview-cli-tunnel.sh first to tunnel through that EC2 box.
TELRAD_BREEZEVIEW_CLI_HOST="216.145.121.132"
TELRAD_BREEZEVIEW_CLI_PORT="9383"
TELRAD_BREEZEVIEW_CLI_USER="your-breezeview-cli-username"
TELRAD_BREEZEVIEW_CLI_PASSWORD="your-breezeview-cli-password"
TELRAD_BREEZEVIEW_CLI_SNAPSHOT_TIMEOUT="240"   # seconds to wait for a kpi-snapshot to finish
TELRAD_BREEZEVIEW_CLI_POLL_INTERVAL="10"       # seconds between snapshot status polls

# Telrad BreezeVIEW CLI tunnel (used only by scripts/telrad-breezeview-cli-tunnel.sh, not
# by the agent itself). A SEPARATE SSH connection from the Zabbix tunnel below — key-auth,
# through the Zabbix-Agent-Server EC2 box, to reach the CLI's source-IP-restricted port.
TELRAD_BREEZEVIEW_CLI_TUNNEL_SSH_KEY="/path/to/your/ec2-key.pem"
TELRAD_BREEZEVIEW_CLI_TUNNEL_SSH_USER="ec2-user"
TELRAD_BREEZEVIEW_CLI_TUNNEL_SSH_HOST="34.236.220.137"
TELRAD_BREEZEVIEW_CLI_TUNNEL_REMOTE="216.145.121.132:9383"
TELRAD_BREEZEVIEW_CLI_TUNNEL_LOCAL_PORT="9383"

# UISP (accessparks.unmsapp.com). Auth: static API token (from the UISP UI,
# under the user profile) sent as the x-auth-token header — there is no
# username/password login call.
UISP_URL="https://accessparks.unmsapp.com"
UISP_API_TOKEN="your-uisp-api-token"

# UniFi (Site Manager API — must be a console-owner key, not a restricted/invited key,
# or Cloud Connector proxy paths return 403 insufficient permissions)
UNIFI_API_KEY="your-unifi-api-key"

# Positron tunnel — rides the SAME SSH connection as the Zabbix tunnel above (see
# scripts/zabbix-tunnel.sh), since Positron is on the same internal subnet. Leave both
# blank to skip forwarding Positron.
POSITRON_TUNNEL_REMOTE="192.168.102.16:443"
POSITRON_TUNNEL_LOCAL_PORT="8443"
