# ServiceNow credentials. Copy this file to .env and fill in the values --
# never put credentials in conf.d/config.ini. A variable already set in the
# real environment (docker run -e / --env-file / the shell) always wins over
# this file, so this is a convenience default for local/dev use, not the only
# way to supply credentials.
#
# Set only the block that matches conf.d/config.ini's [servicenow] auth_type.

## auth_type = oauth2 (password grant against /oauth_token.do -- fixed, not configurable)
SERVICENOW_OAUTH_CLIENT_ID=
SERVICENOW_OAUTH_CLIENT_SECRET=
SERVICENOW_OAUTH_USERNAME=
SERVICENOW_OAUTH_PASSWORD=

## auth_type = basic
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
